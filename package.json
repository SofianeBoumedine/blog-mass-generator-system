{
  "name": "blog-mass-generator-system",
  "version": "2.0.0",
  "description": "Système de génération en masse de sites web complets avec blogs intégrés utilisant l'IA Perplexity",
  "main": "generator-main.js",
  "type": "commonjs",
  "scripts": {
    "start": "node generator-main.js",
    "generate": "node generator-main.js",
    "generate:txt": "node scripts/generate-from-txt.js",
    "generate:mass": "node scripts/mass-generate.js",
    "deploy": "node scripts/deploy-ftp.js",
    "test": "node test/test-runner.js",
    "test:semantic": "node scripts/generate-from-txt.js keywords/exemples/animaux-chiens.txt ./output/test-chiens",
    "cleanup": "node scripts/cleanup.js",
    "monitor": "node scripts/monitor.js",
    "validate": "node scripts/validate-keywords.js",
    "bulk": "node scripts/bulk-generate.js",
    "health": "node scripts/monitor.js health",
    "demo": "node test-demo.js",
    "example": "node generator-main.js exemple.com examples/keywords-test.txt --max-articles 5 --verbose"
  },
  "bin": {
    "bmg": "./generator-main.js",
    "blog-mass-generator": "./generator-main.js"
  },
  "keywords": [
    "blog",
    "generator",
    "ai",
    "perplexity",
    "website",
    "mass",
    "automation",
    "content",
    "seo",
    "templates",
    "cms"
  ],
  "dependencies": {
    "axios": "^1.12.2",
    "basic-ftp": "^5.0.4",
    "dotenv": "^16.6.1",
    "fs-extra": "^11.2.0",
    "p-limit": "^3.1.0",
    "slugify": "^1.6.6"
  },
  "author": "Blog Mass Generator System",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/blog-mass-generator-system.git"
  },
  "config": {
    "default-max-articles": 50,
    "default-delay": 3000,
    "supported-frameworks": [
      "bootstrap",
      "tailwind",
      "bulma",
      "materialize",
      "foundation",
      "semantic-ui",
      "pure-css",
      "milligram",
      "skeleton",
      "spectre",
      "tachyons",
      "water-css",
      "new-css",
      "mvp-css",
      "pico-css",
      "holiday-css",
      "marx-css",
      "bamboo-css",
      "sakura-css",
      "vanilla-framework"
    ]
  }
}
